{
  "manifest_version": 3,
  "name": "LinkNest Extension",
  "version": "1.0.0",

  "permissions": ["storage", "activeTab", "scripting"],

  "host_permissions": ["https://www.linkedin.com/*"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"]
    }
  ]
}